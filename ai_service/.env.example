APP_NAME=VogueAI-AI-Service
APP_ENV=local
HOST=127.0.0.1
PORT=8001

AI_INTERNAL_TOKEN=change_this_internal_ai_token
AI_MOCK_MODE=true

EMBEDDING_PROVIDER=clip
EMBEDDING_MODEL=clip-vit-base-patch32
EMBEDDING_MODEL_REPOSITORY=openai/clip-vit-base-patch32
LOCAL_MODEL_ROOT=models
MODEL_DEVICE=auto

VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_COLLECTION=vogueai_clothing_embeddings
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_TARGET_VECTOR_SIZE=512
VECTOR_STORE_ACTIVE_VECTOR_SIZE=8
VECTOR_STORE_DISTANCE=Cosine
VECTOR_STORE_TIMEOUT_SECONDS=10

IMAGE_CAPTION_PROVIDER=blip
IMAGE_CAPTION_MODEL=Salesforce/blip-image-captioning-base
IMAGE_CAPTION_MODEL_REPOSITORY=Salesforce/blip-image-captioning-base
VQA_PROVIDER=blip
VQA_MODEL=Salesforce/blip-vqa-base
VQA_MODEL_REPOSITORY=Salesforce/blip-vqa-base
ATTRIBUTE_PROVIDER=fashion_multioutput
ATTRIBUTE_MODEL=fashion_multioutput_v4_smart_tuned
ATTRIBUTE_MODEL_REPOSITORY=models/fashion_multioutput_v4_smart_tuned.pth
POSE_PROVIDER=yolo
POSE_MODEL=yolo11s-pose
POSE_MODEL_REPOSITORY=models/yolo11s-pose.pt

TRYON_PROVIDER=huggingface_idm_vton
TRYON_MODEL=idm-vton
TRYON_SPACE=yisol/IDM-VTON
TRYON_API_TOKEN=
TRYON_PUBLIC_BASE_URL=http://127.0.0.1:8001
TRYON_OUTPUT_DIR=static/tryon
TRYON_TIMEOUT_SECONDS=180

AI_MODEL_CACHE_DIR=models/huggingface

# Laravel-side external providers:
# AI_TRYON_PROVIDER / AI_TRYON_API_KEY
# AI_VIDEO_PROVIDER / VEO_API_KEY / RUNWAY_API_KEY
# AI_DIGITAL_TWIN_PROVIDER / AI_DIGITAL_TWIN_API_KEY
